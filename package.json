{
  "name": "odgruz",
  "version": "0.1.0",
  "description": "Interactive disk cleanup for macOS with a before/after HTML report",
  "keywords": [
    "macos",
    "disk",
    "cleanup",
    "cache",
    "node_modules",
    "cli"
  ],
  "repository": "github:zagi/odgruz",
  "type": "module",
  "bin": {
    "odgruz": "dist/cli.mjs"
  },
  "files": [
    "dist",
    "README-PL.md"
  ],
  "engines": {
    "node": ">=20.12"
  },
  "os": [
    "darwin"
  ],
  "license": "MIT",
  "scripts": {
    "build": "tsdown",
    "prepare": "tsdown",
    "test": "vitest run",
    "test:e2e": "tsdown && vitest run --config vitest.e2e.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@clack/prompts": "^1.8.1",
    "@types/node": "^26.6.3",
    "picocolors": "^1.1.1",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
